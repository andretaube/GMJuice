{
  "version": "1.0",
  "description": "Parsing rules for SCSA classification page",
  "rules": {
    "memberName": {
      "selector": "td:contains(Member Name) + td",
      "method": "first",
      "extract": "text"
    },
    "allStageScoresSection": {
      "headerSelector": "h2:contains(All Stage Scores)",
      "tableSelector": "#ClassifiersTable",
      "findMethod": "preferLast"
    },
    "divisionHeaders": {
      "selector": "tr.table-secondary th",
      "extract": "text"
    },
    "stageScoreRows": {
      "rowSelector": "tbody tr",
      "divisionHeaderSelector": "th.text-center",
      "classificationIndicator": {
        "cellIndex": 5,
        "method": "notContains",
        "value": "text-danger"
      },
      "cells": {
        "matchName": {
          "index": 0,
          "extract": "text"
        },
        "date": {
          "index": 1,
          "extract": "text",
          "format": "MMM dd, yyyy"
        },
        "stageCode": {
          "index": 2,
          "extract": "text"
        },
        "time": {
          "index": 3,
          "extract": "text",
          "type": "double"
        },
        "peakTime": {
          "index": 4,
          "extract": "text",
          "type": "double"
        }
      }
    },
    "divisionMapping": {
      "Rimfire Pistol Open": "RFPO",
      "Rimfire Pistol Iron": "RFPI",
      "Rimfire Rifle Open": "RFRO",
      "Rimfire Rifle Iron": "RFRI",
      "Open": "OPN",
      "Carry Optics": "CO",
      "Limited": "LTD",
      "Production": "PROD",
      "Single Stack": "SS",
      "PCC": "PCC",
      "PCC Optics": "PCCO",
      "PCC Iron": "PCCI",
      "Open Sight Revolver": "OSR",
      "Iron Sight Revolver": "ISR",
      "Revolver": "REV"
    },
    "classificationsSection": {
      "headerSelector": "h2:contains(Classifications)",
      "tableSelector": "#classificationsTable",
      "findMethod": "direct",
      "rowSelector": "tbody tr",
      "cells": {
        "division": {
          "index": 1,
          "extract": "text",
          "comment": "Division code (OPN, RFPO, etc.)"
        },
        "class": {
          "index": 2,
          "extract": "text"
        },
        "currentPercent": {
          "index": 3,
          "extract": "text"
        },
        "highPercent": {
          "index": 4,
          "extract": "text"
        },
        "date": {
          "index": 5,
          "extract": "text",
          "format": "MMM dd, yyyy"
        }
      }
    }
  }
}
